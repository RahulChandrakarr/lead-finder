# --- Database (Supabase Postgres) ---
# Use the transaction pooler (IPv4), not the direct db.<ref>.supabase.co host.
# That direct host is IPv6-only and the app cannot reach it from Vercel.
# Dashboard → Connect → Transaction pooler (port 6543).
# If you paste the direct URL anyway, the app rewrites it using SUPABASE_POOLER_REGION (default ap-south-1).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_REGION=ap-south-1

# --- Apify (lead scraping) — create at https://console.apify.com/settings/integrations ---
APIFY_TOKEN=

# --- Gmail / Google Workspace (Mail accounts page → Connect Gmail) ---
# OAuth client (Web application) from console.cloud.google.com; redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Gmail tokens. Keep it stable — changing it disconnects all accounts.
ENCRYPTION_KEY=

# --- SMTP (optional fallback sender when no Gmail account is chosen) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Name <you@yourdomain.com>"
# Physical mailing address, required in the footer of cold email (CAN-SPAM)
MAIL_POSTAL_ADDRESS=
# Max emails sent per day, and per batch run
DAILY_SEND_LIMIT=50
BATCH_SIZE=10

# --- App ---
APP_URL=http://localhost:3000
# Password for the dashboard (HTTP basic auth, any username)
APP_PASSWORD=
# Secret for the /api/cron/send endpoint (?secret=... or Authorization: Bearer ...)
CRON_SECRET=
